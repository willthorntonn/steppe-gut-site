node_modules
dist
.DS_Store
*.local
.vercel
asset-src/

# Scratch files - working images and throwaway scripts that are not part of
# the site. They stay on disk, they just do not belong in the history.
/scratchpad_pav.jpg
/scripts-fetch-tmp.mjs
/src/subpages/fruit bowl.png

# The account API store. Real accounts, hashed passwords and orders -
# it belongs on the machine that runs the server, never in the history.
server/data/*.json
server/data/*.corrupt-*

# Next.js build output. `.next` is the production build, `.next-dev` is the
# dev server's own copy - see the distDir note in next.config.mjs.
.next
.next-dev
